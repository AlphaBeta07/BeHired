{
  "extends": "./tsconfig.json",
  "include": ["server/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist", "src"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "dist/server",
    "types": ["node"]
  }
}
