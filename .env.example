# ==========================================
# BeHired Backend & Secrets Configuration
# ==========================================

# Port the Express server listens on
SERVER_PORT=3001

# Secret key for Express sessions (Change this in production to a random string)
SESSION_SECRET="your-super-secret-session-key"

# ==========================================
# Frontend Firebase Client Variables
# ==========================================
# Find these in your Firebase Project Settings -> General -> Your apps -> Web App
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_URL=""


# measurementId: "T"
# ==========================================
# Backend Firebase Admin (Service Account)
# ==========================================
# Generated from Firebase Project Settings -> Service Accounts -> Generate new private key
# Provide the stringified JSON here, e.g.: '{"type": "service_account", "project_id": "...", ...}'
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'

# ==========================================
# AI / ML - Google Gemini Pro
# ==========================================
# Get this from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""